# GENERATED by the Claude Code add-on __ADDON_VERSION__ at __GENERATED_AT__ — DO NOT EDIT; rewritten on every add-on start.
# Contains the job-endpoint bearer token. Keep this file out of anything you publish (see README: "git-backed config").
# Enable with (configuration.yaml, then restart Home Assistant once):  homeassistant: / packages: / claudecode_jobs: !include claudecode_jobs.yaml
#
#   homeassistant:
#     packages:
#       claudecode_jobs: !include claudecode_jobs.yaml
#
# If your configuration.yaml already uses `packages: !include_dir_named packages`, do not add the line above;
# instead symlink or copy this file into that directory (see README). The add-on always writes it here.
#
# What is in here (fixed; nothing is per-job — Claude Code add-on, design "Claude Jobs" §4.10):
#   rest_command.claude_job_run / claude_job_set_enabled / claude_job_republish   → call the add-on's job endpoint
#   rest:      sensor.claude_jobs_attention      → the alarm anchor (polls GET /jobs; unavailable = endpoint down)
#   rest:      sensor.claude_usage_* / binary_sensor.claude_usage_stale → Claude subscription usage (polls GET /usage;
#              whole-account Max/Pro plan limits; omitted when the add-on option enable_usage_sensors is off)
#   template:  sensor.claude_jobs_monthly_cost   → statistics-grade monthly spend
#   template:  sensor.claude_usage_weekly_<surface> → each surface's share of this week's usage, as plain % sensors
#   automation: republish on HA start · attention alarm · alarm clear
#   a commented-out example schedule (use the "Claude Job · run on a schedule" blueprint instead)

rest_command:
  claude_job_run:
    # data: {job: <name>, input: {...}?}  →  POST /jobs/<name>/run  (202 accepted, or 200 {"accepted": false, "reason": ...})
    # no `| urlencode` on {{ job }}: rest_command re-encodes the URL itself; job names are slug-checked by the endpoint anyway.
    url: "http://__CLAUDECODE_HOST__:__CLAUDECODE_PORT__/jobs/{{ job }}/run"
    method: post
    content_type: "application/json"
    headers:
      Authorization: "Bearer __CLAUDECODE_TOKEN__"
      Accept: "application/json"
    payload: "{{ {'input': (input | default({}, true))} | to_json }}"
    timeout: 10

  claude_job_set_enabled:
    # data: {job: <name>, enabled: true|false}  →  POST /jobs/<name>/enable|disable  (the hard kill switch)
    url: "http://__CLAUDECODE_HOST__:__CLAUDECODE_PORT__/jobs/{{ job }}/{{ 'enable' if (enabled | default(true) | bool(true)) else 'disable' }}"
    method: post
    content_type: "application/json"
    headers:
      Authorization: "Bearer __CLAUDECODE_TOKEN__"
    payload: "{}"
    timeout: 10

  claude_job_republish:
    # POST /republish — asks the add-on to re-post every sensor.claude_job_* entity (they live in the state machine only)
    url: "http://__CLAUDECODE_HOST__:__CLAUDECODE_PORT__/republish"
    method: post
    content_type: "application/json"
    headers:
      Authorization: "Bearer __CLAUDECODE_TOKEN__"
    payload: "{}"
    timeout: 10

rest:
  - resource: "http://__CLAUDECODE_HOST__:__CLAUDECODE_PORT__/jobs"
    method: GET                       # must be upper-case here (rest_command above is lower-case)
    scan_interval: __SCAN_INTERVAL__
    timeout: 10
    headers:
      Authorization: "Bearer __CLAUDECODE_TOKEN__"
      Accept: "application/json"
    sensor:
      - name: "Claude Jobs Attention"           # → sensor.claude_jobs_attention; state = number of jobs needing attention
        unique_id: "claudecode_jobs_attention"  # registry entry: survives restarts (restored as `unavailable` until the first poll)
        icon: "mdi:robot-industrial"
        # 401 / garbage body → unavailable instead of a bogus number (value_json exists only if the body parsed as JSON)
        availability: "{{ value_json is defined and value_json is mapping and 'attention' in value_json }}"
        value_template: "{{ value_json.attention | int(0) }}"
        state_class: measurement                # history graph as a line
        json_attributes:
          - worst_status
          - stale_jobs
          - failed_jobs
          - disabled_jobs
          - running
          - job_count
          - cost_month_usd
          - cost_month_start
          - cli_drift
          - claude_version
          - preflight
          - endpoint_version

  # __USAGE_BEGIN__ — Claude subscription usage (add-on option enable_usage_sensors; the add-on polls
  # api.anthropic.com every usage_poll_interval seconds and serves the last snapshot on GET /usage; this
  # block polls at the same cadence). Values are whole-account: every Claude surface on the subscription.
  # On a failed refresh (expired login token, network) the add-on keeps serving the LAST GOOD numbers with
  # stale: true — these sensors never drop to zero, and binary_sensor.claude_usage_stale says when to doubt them.
  - resource: "http://__CLAUDECODE_HOST__:__CLAUDECODE_PORT__/usage"
    method: GET
    scan_interval: __USAGE_SCAN_INTERVAL__
    timeout: 10
    headers:
      Authorization: "Bearer __CLAUDECODE_TOKEN__"
      Accept: "application/json"
    binary_sensor:
      - name: "Claude Usage Stale"                # → binary_sensor.claude_usage_stale; on = the numbers below are not fresh
        unique_id: "claudecode_usage_stale"       #   (last poll failed and the last good values are shown, or no data yet)
        device_class: problem
        availability: "{{ value_json is defined and value_json is mapping and 'stale' in value_json }}"
        value_template: "{{ (value_json.stale | bool(false)) or not (value_json.has_data | bool(false)) }}"
    sensor:
      - name: "Claude Usage Last Success"         # → sensor.claude_usage_last_success; when the numbers were last fetched;
        unique_id: "claudecode_usage_last_success" #  attributes carry the poll health (last_error, age_s, token expiry)
        device_class: timestamp
        icon: "mdi:cloud-check-outline"
        availability: "{{ value_json is defined and value_json is mapping and value_json.last_success is string }}"
        value_template: "{{ value_json.last_success }}"
        json_attributes:
          - stale
          - last_error
          - last_error_detail
          - last_attempt
          - age_s
          - poll_interval_s
          - credential_expires_at
          - subscription_type
          - rate_limit_tier
      - name: "Claude Usage Session"              # → sensor.claude_usage_session; the 5-hour window, % used
        unique_id: "claudecode_usage_session"
        unit_of_measurement: "%"
        state_class: measurement
        icon: "mdi:timer-sand"
        availability: "{{ value_json is defined and value_json is mapping and value_json.session is mapping and value_json.session.used_percent is number }}"
        value_template: "{{ value_json.session.used_percent }}"
        json_attributes_path: "$.session"
        json_attributes:
          - resets_at
          - severity
          - is_active
      - name: "Claude Usage Session Reset"        # → sensor.claude_usage_session_reset
        unique_id: "claudecode_usage_session_reset"
        device_class: timestamp
        availability: "{{ value_json is defined and value_json is mapping and value_json.session is mapping and value_json.session.resets_at is string }}"
        value_template: "{{ value_json.session.resets_at }}"
      - name: "Claude Usage Weekly"               # → sensor.claude_usage_weekly; the 7-day window across all models, % used;
        unique_id: "claudecode_usage_weekly"      #   attribute `breakdown` = {claude_code, chats, cowork, other}: each surface's
                                                  #   SHARE of this week's usage in % (sums to 100; not % of the cap)
        unit_of_measurement: "%"
        state_class: measurement
        icon: "mdi:calendar-week"
        availability: "{{ value_json is defined and value_json is mapping and value_json.weekly is mapping and value_json.weekly.used_percent is number }}"
        value_template: "{{ value_json.weekly.used_percent }}"
        json_attributes_path: "$.weekly"
        json_attributes:
          - resets_at
          - severity
          - is_active
          - breakdown
          - breakdown_rows
          - breakdown_as_of
          - breakdown_window_started_at
      - name: "Claude Usage Weekly Reset"         # → sensor.claude_usage_weekly_reset
        unique_id: "claudecode_usage_weekly_reset"
        device_class: timestamp
        availability: "{{ value_json is defined and value_json is mapping and value_json.weekly is mapping and value_json.weekly.resets_at is string }}"
        value_template: "{{ value_json.weekly.resets_at }}"
      - name: "Claude Usage Weekly Model"         # → sensor.claude_usage_weekly_model; the per-model weekly cap (attribute
        unique_id: "claudecode_usage_weekly_model" #  `model` names it); can run ahead of the all-model weekly figure
        unit_of_measurement: "%"
        state_class: measurement
        icon: "mdi:brain"
        availability: "{{ value_json is defined and value_json is mapping and value_json.weekly_scoped is mapping and value_json.weekly_scoped.used_percent is number }}"
        value_template: "{{ value_json.weekly_scoped.used_percent }}"
        json_attributes_path: "$.weekly_scoped"
        json_attributes:
          - model
          - resets_at
          - severity
          - is_active
      - name: "Claude Usage Weekly Model Reset"   # → sensor.claude_usage_weekly_model_reset
        unique_id: "claudecode_usage_weekly_model_reset"
        device_class: timestamp
        availability: "{{ value_json is defined and value_json is mapping and value_json.weekly_scoped is mapping and value_json.weekly_scoped.resets_at is string }}"
        value_template: "{{ value_json.weekly_scoped.resets_at }}"
      - name: "Claude Usage Extra Used"           # → sensor.claude_usage_extra_used; extra (pay-as-you-go) usage, % of its monthly limit
        unique_id: "claudecode_usage_extra_used"
        unit_of_measurement: "%"
        state_class: measurement
        icon: "mdi:cash-plus"
        availability: "{{ value_json is defined and value_json is mapping and value_json.extra_usage is mapping and value_json.extra_usage.utilization is number }}"
        value_template: "{{ value_json.extra_usage.utilization }}"
        json_attributes_path: "$.extra_usage"
        json_attributes:
          - is_enabled
          - monthly_limit
          - used_credits
          - currency
          - disabled_reason
      - name: "Claude Usage Extra Spend"          # → sensor.claude_usage_extra_spend; extra usage spent this month in major units
        unique_id: "claudecode_usage_extra_spend" #   (the add-on converts the API's minor units; `currency` sits on Extra Used)
        device_class: monetary
        state_class: total
        unit_of_measurement: "USD"
        availability: "{{ value_json is defined and value_json is mapping and value_json.extra_usage is mapping and value_json.extra_usage.used_credits is number }}"
        value_template: "{{ value_json.extra_usage.used_credits }}"
  # __USAGE_END__

template:
  - sensor:
      - name: "Claude Jobs Monthly Cost"        # → sensor.claude_jobs_monthly_cost
        unique_id: "claudecode_jobs_monthly_cost"
        device_class: monetary
        state_class: total                      # monetary allows only `total`; last_reset marks the month rollover
        unit_of_measurement: "USD"
        availability: "{{ state_attr('sensor.claude_jobs_attention', 'cost_month_usd') | is_number }}"
        state: "{{ state_attr('sensor.claude_jobs_attention', 'cost_month_usd') | float(0) | round(2) }}"
        last_reset: "{{ state_attr('sensor.claude_jobs_attention', 'cost_month_start') }}"
  # __USAGE_BEGIN__ — the weekly breakdown by surface as plain % sensors: each surface's SHARE of this week's usage
  # (they sum to 100; "Claude Code 96 %" is 96 % of what was used, not of the limit). Each is `unavailable` while the
  # API reports no row of that name; the raw rows stay on sensor.claude_usage_weekly's `breakdown_rows` attribute.
  - sensor:
      - name: "Claude Usage Weekly Claude Code"   # → sensor.claude_usage_weekly_claude_code
        unique_id: "claudecode_usage_weekly_claude_code"
        unit_of_measurement: "%"
        state_class: measurement
        icon: "mdi:console"
        availability: "{{ (state_attr('sensor.claude_usage_weekly', 'breakdown') or {}).get('claude_code') is number }}"
        state: "{{ (state_attr('sensor.claude_usage_weekly', 'breakdown') or {}).get('claude_code') }}"
      - name: "Claude Usage Weekly Chats"         # → sensor.claude_usage_weekly_chats
        unique_id: "claudecode_usage_weekly_chats"
        unit_of_measurement: "%"
        state_class: measurement
        icon: "mdi:chat-outline"
        availability: "{{ (state_attr('sensor.claude_usage_weekly', 'breakdown') or {}).get('chats') is number }}"
        state: "{{ (state_attr('sensor.claude_usage_weekly', 'breakdown') or {}).get('chats') }}"
      - name: "Claude Usage Weekly Cowork"        # → sensor.claude_usage_weekly_cowork
        unique_id: "claudecode_usage_weekly_cowork"
        unit_of_measurement: "%"
        state_class: measurement
        icon: "mdi:account-group-outline"
        availability: "{{ (state_attr('sensor.claude_usage_weekly', 'breakdown') or {}).get('cowork') is number }}"
        state: "{{ (state_attr('sensor.claude_usage_weekly', 'breakdown') or {}).get('cowork') }}"
      - name: "Claude Usage Weekly Other"         # → sensor.claude_usage_weekly_other
        unique_id: "claudecode_usage_weekly_other"
        unit_of_measurement: "%"
        state_class: measurement
        icon: "mdi:dots-horizontal-circle-outline"
        availability: "{{ (state_attr('sensor.claude_usage_weekly', 'breakdown') or {}).get('other') is number }}"
        state: "{{ (state_attr('sensor.claude_usage_weekly', 'breakdown') or {}).get('other') }}"
  # __USAGE_END__

automation:
  - id: claudecode_jobs_republish_on_start
    alias: "Claude Jobs · republish entities when Home Assistant starts"
    description: "Per-job sensor.claude_job_* entities live in the state machine only; ask the add-on to re-post them after a Core restart."
    mode: single
    triggers:
      - trigger: homeassistant
        event: start
    actions:
      - delay: "00:00:30"
      - action: rest_command.claude_job_republish
        continue_on_error: true        # swallows connection-refused/timeout; a non-2xx only logs a warning anyway

  - id: claudecode_jobs_alarm
    alias: "Claude Jobs · attention alarm"
    description: "Fires when any job is stale/failed for 5 min, or the add-on endpoint has been unreachable for 10 min."
    mode: restart
    max_exceeded: silent
    triggers:
      # template (not numeric_state): treats `unavailable`/missing as 0, so an unavailable→N transition after a
      # restart still arms and fires, and no "Error initializing trigger" warning is logged at every boot.
      - trigger: template
        id: attention
        value_template: "{{ states('sensor.claude_jobs_attention') | int(0) > 0 }}"
        for: "00:05:00"
      - trigger: state
        id: endpoint_down
        entity_id: sensor.claude_jobs_attention
        to:
          - "unavailable"
          - "unknown"
        for: "00:10:00"
      # backstop: persistent notifications do not survive a Core restart, and neither trigger above re-fires
      # if the condition already held when the automation was (re)loaded.
      - trigger: homeassistant
        id: ha_start
        event: start
    actions:
      - if:
          - condition: trigger
            id: ha_start
        then:
          - delay: "00:10:30"
      - condition: or
        conditions:
          - condition: template
            value_template: "{{ states('sensor.claude_jobs_attention') | int(0) > 0 }}"
          - condition: state
            entity_id: sensor.claude_jobs_attention
            state:
              - "unavailable"
              - "unknown"
      - variables:
          endpoint_down: "{{ states('sensor.claude_jobs_attention') in ['unavailable', 'unknown'] }}"
          stale: "{{ state_attr('sensor.claude_jobs_attention', 'stale_jobs') or [] }}"
          failed: "{{ state_attr('sensor.claude_jobs_attention', 'failed_jobs') or [] }}"
          alarm_title: >-
            {{ 'Claude Jobs endpoint unreachable' if endpoint_down else
               'Claude Jobs need attention (' ~ (states('sensor.claude_jobs_attention') | int(0)) ~ ')' }}
          alarm_message: >-
            {% if endpoint_down %}
            sensor.claude_jobs_attention has been {{ states('sensor.claude_jobs_attention') }} for 10+ minutes:
            the Claude Code add-on is stopped, its job endpoint is down, or the token/hostname in
            claudecode_jobs.yaml is stale (restart the add-on to re-render it; it reloads RESTful Command and REST itself).
            {% else %}
            Stale: {{ stale | join(', ') if stale else 'none' }} ·
            Failed: {{ failed | join(', ') if failed else 'none' }} ·
            Worst status: {{ state_attr('sensor.claude_jobs_attention', 'worst_status') }}.
            See the sensor.claude_job_* entities for detail.
            {% endif %}
      - action: persistent_notification.create      # always exists; the same notification_id replaces in place
        data:
          notification_id: claude_jobs_alarm
          title: "{{ alarm_title }}"
          message: "{{ alarm_message }}"
      # notify.notify exists only once some notify platform is loaded, and continue_on_error does NOT swallow
      # ServiceNotFound (helpers/script.py). It is therefore deliberately the LAST step: on a bare install the
      # trace ends with an error here, but the persistent notification above has already been created.
      - action: notify.notify
        continue_on_error: true
        data:
          title: "{{ alarm_title }}"
          message: "{{ alarm_message | truncate(900) }}"

  - id: claudecode_jobs_alarm_clear
    alias: "Claude Jobs · clear attention alarm"
    mode: single
    triggers:
      - trigger: template
        value_template: >-
          {{ states('sensor.claude_jobs_attention') not in ['unavailable', 'unknown']
             and states('sensor.claude_jobs_attention') | int(1) == 0 }}
        for: "00:02:00"
    actions:
      - action: persistent_notification.dismiss   # dismissing a non-existent id is a silent no-op
        data:
          notification_id: claude_jobs_alarm

  # ── Example schedule (commented out: a live daily run on the default model is a spend decision only you can make) ──
  # Prefer the UI: Settings → Automations & scenes → Blueprints → "Claude Job · run on a schedule".
  # - id: claudecode_jobs_example_health_check_daily
  #   alias: "Claude Jobs · run health-check every morning"
  #   mode: single
  #   triggers:
  #     - trigger: time
  #       at: "07:15:00"
  #   actions:
  #     - action: rest_command.claude_job_run
  #       continue_on_error: true
  #       data:
  #         job: health-check
  #         input: {}                # optional; becomes {"input": {...}} in the POST body
  #       # response_variable: run   # then run.content.run_id / run.status (202, or 200 with accepted: false)

