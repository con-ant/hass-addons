#!/bin/bash
# Auto-launch wrapper: run claude with runtime flags, fall back to a login
# shell on exit so users can keep working. (The update_mcp_token call that
# used to be here persisted $SUPERVISOR_TOKEN into settings.json on the HA
# volume — a token leak into backups; hass-mcp reads HA_TOKEN from the
# environment instead. Removed.)
source /root/.bashrc 2>/dev/null

CREDS=/root/.claude/.credentials.json

# Pre-flight auth check.
#
# The claude.ai OAuth *refresh* token does not slide forward when the access
# token renews — an access-token refresh moves `expiresAt` while leaving
# `refreshTokenExpiresAt` untouched — so the login lapses on a fixed date even
# on a box that never stops running. Once it has lapsed, `claude --continue
# --remote-control` opens an interactive login prompt, and a Remote Control
# client has no way to answer one: the session simply never connects, with
# nothing in this log to say why. Print the reason instead of failing silently.
#
# This is a function because it must run before EVERY launch, not just the
# first: on an unattended box the token lapses mid-supervision, weeks after the
# wrapper started, and the relaunch that follows is exactly the launch that
# strands. A one-shot check at start would have passed back then and said
# nothing now.
check_login() {
  [ -f "$CREDS" ] || return 0
  # Emit nothing unless the OAuth expiry is actually present. Defaulting a
  # missing field to 0 would date the login to 1970 and report every API-key
  # install — and any half-written file — as expired.
  local days
  days=$(jq -r 'try (if (.claudeAiOauth.refreshTokenExpiresAt | type) == "number"
                     then ((.claudeAiOauth.refreshTokenExpiresAt / 1000 - now) / 86400 | floor)
                     else empty end) catch empty' "$CREDS" 2>/dev/null)
  [[ "$days" =~ ^-?[0-9]+$ ]] || return 0
  # floor() rounds toward -inf, so 0 means "expires within the next 24h", not
  # "expired" — 12h of validity left is 0.5 -> 0. Only a negative day count is
  # actually past the deadline; treat 0 as "expires today".
  if [ "$days" -lt 0 ]; then
    echo "[ERROR] claude.ai login has expired. Run /login in this terminal." >&2
    echo "[ERROR] Remote Control cannot answer a login prompt and will not connect until you do." >&2
  elif [ "$days" -le 5 ]; then
    if [ "$days" -eq 0 ]; then
      echo "[WARN] claude.ai login expires today. Run /login before it lapses." >&2
    else
      echo "[WARN] claude.ai login expires in ${days} day(s). Run /login before it lapses." >&2
    fi
  fi
}
check_login

# Supervise claude instead of running it once.
#
# Previously a single `claude $AUTO_LAUNCH_ARGS` fell straight through to the
# login shell below on any exit. That is right when the user types /exit, but
# it also means a crash or a dropped session silently ends Remote Control until
# somebody opens the web terminal and restarts it by hand — which defeats the
# point of running unattended. Relaunch on a non-zero exit with --continue, so
# the box recovers its own session; a clean exit still drops to the shell.
#
# Backoff doubles to a 60s ceiling, and resets once a run has lasted a minute,
# so a genuine crash loop backs off while an ordinary long session that dies
# once reconnects promptly.
if [ -n "$AUTO_LAUNCH_ARGS" ]; then
  # Catch SIGINT rather than dying on it. In a fast crash loop the wrapper spends
  # nearly all its time in the sleep below — which is exactly when a user reaches
  # for Ctrl-C — and an untrapped SIGINT there kills this script outright, so it
  # never reaches the login shell handover and the respawn just relaunches the
  # failing claude. That would make a shell unreachable precisely when it is what
  # you need to recover (downgrade the CLI, /login, repair settings). While claude
  # itself runs the terminal is in raw mode, so this only fires during the sleep.
  trap 'interrupted=1' INT
  backoff=2
  fast_fails=0
  while :; do
    started=$SECONDS
    claude $AUTO_LAUNCH_ARGS
    rc=$?
    # 0   the user typed /exit
    # 130 SIGINT  - Ctrl-C out of Claude
    # 143 SIGTERM - the supervisor is stopping us
    # 129 SIGHUP  - the terminal went away (ttyd's configured close signal)
    # All four are somebody meaning it, so hand over to the login shell. Anything
    # else is a crash. 137 (SIGKILL) is deliberately NOT here: an OOM kill is
    # exactly the case worth recovering from, and during a real container kill
    # this loop dies with the container anyway.
    case $rc in
      0|129|130|143) break ;;
    esac
    # Distinguish "crashes sometimes" from "cannot start at all". A run that
    # died within 5s did not get going; five of those in a row means claude is
    # failing deterministically (unknown flag after a CLI update, corrupted
    # install, incompatible runtime) and no amount of relaunching will help —
    # but a shell will. Real crashes are long runs that die occasionally and
    # never accumulate consecutive fast failures, so unattended recovery is
    # unaffected. Without this cap the loop was unescapable in exactly the
    # case where a shell is needed to fix it.
    if [ $((SECONDS - started)) -lt 5 ]; then
      fast_fails=$((fast_fails + 1))
    else
      fast_fails=0
    fi
    if [ "$fast_fails" -ge 5 ]; then
      echo "[ERROR] claude failed to start $fast_fails times in a row (last status $rc); dropping to a shell so it can be fixed" >&2
      break
    fi
    [ $((SECONDS - started)) -ge 60 ] && backoff=2
    echo "[WARN] claude exited unexpectedly (status $rc); relaunching in ${backoff}s" >&2
    sleep "$backoff"
    # Ctrl-C during the wait means stop: same handover as the 130 case above.
    [ -n "$interrupted" ] && break
    [ "$backoff" -lt 60 ] && backoff=$((backoff * 2))
    # Always resume after an unexpected exit, even when auto_launch_claude is
    # "new" — the conversation that died is the one worth getting back.
    AUTO_LAUNCH_ARGS="--continue $CLAUDE_FLAGS"
    # The token may have lapsed since the last launch; say so before relaunching
    # into a prompt Remote Control cannot answer.
    check_login
  done
else
  claude
fi

exec bash --login
