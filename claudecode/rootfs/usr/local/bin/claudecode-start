# ttyd only spawns SHELL_CMD when a browser connects, so on a headless box
# nothing runs after a restart until somebody opens the web terminal - and
# Remote Control, whose whole point is running unattended, stays down. When
# Remote Control is on, create the tmux session detached before ttyd starts;
# ttyd's `tmux new-session -A` then attaches to it instead of creating it.
#
# This must run before ttyd: the first `new-session` starts the tmux server,
# which takes its environment (HA_TOKEN, CLAUDE_FLAGS, AUTO_LAUNCH_ARGS, the
# Remote Control prefix) from this process; later panes inherit the server's.
prestart_session() {
  [ "$ENABLE_RC" = "true" ] || return 0
  [ "$AUTO_LAUNCH" != "off" ] || return 0
  if [ "$SESSION_PERSIST" != "true" ]; then
    warn "enable_remote_control is on but session_persistence is off: without tmux nothing can hold a Claude session, so Remote Control will not connect until the web terminal is opened"
    return 0
  fi
  cd_work
  local out
  # shellcheck disable=SC2086  # PRESTART_CMD is intentionally word-split
  if out=$($PRESTART_CMD 2>&1); then
    info "Claude session started at boot; Remote Control does not wait for a browser"
  else
    warn "Could not pre-start the Claude session (${out:-no output}); it will start when the web terminal is opened"
  fi
}

build_shell_cmd
prestart_session
start_job_endpoint

trap - EXIT
start_ttyd
