#!/bin/bash
# Add-on startup: read options, wire up the persistent config dir, configure
# Claude Code, then hand off to ttyd.
#
# Every step here is best-effort. Whatever goes wrong - a settings.json that
# no longer parses, an npm registry that never answers, a volume that refuses
# writes - the web terminal must still come up, because it is the only way to
# diagnose the problem from inside the add-on. That guarantee lives in one
# place: the script never sets -e (a failing step warns and moves on), and the
# EXIT trap below starts a bare ttyd if anything still ends the script before
# the normal hand-off at the bottom.

PERSIST_DIR=/homeassistant/.claudecode
SETTINGS_FILE=/root/.claude/settings.json
OPTS=/data/options.json

# ---------------------------------------------------------------------------
# The guarantee: always end in ttyd.
# ---------------------------------------------------------------------------
# Seconds a running Claude gets to exit after SIGTERM before the tmux server
# is killed. Must fit inside config.yaml's `timeout:` (30) together with the
# ttyd teardown below; the README/CHANGELOG quote this number.
STOP_GRACE_SECS=10
# Claude Jobs (docs/DESIGN-claude-jobs.md §4.1): definitions and state live on
# the HA volume, the job cwd and endpoint token on /data, runtime files on /run.
JOBS_DIR=$PERSIST_DIR/jobs
JOB_DATA_DIR=/data/claude-jobs
RUN_DIR=/run/claudecode
# In-flight job runs get this long after SIGTERM before SIGKILL; part of the
# on_stop budget below (Appendix A.1: <= 27 s against config.yaml timeout: 30).
JOB_STOP_GRACE_SECS=5
JOB_ENDPOINT_PORT=7682
JOB_ENDPOINT_BIN=${JOB_ENDPOINT_BIN:-/usr/local/bin/claude-job-endpoint}
JOB_LIB=/usr/local/lib/claude-job

cd_work() { cd /homeassistant 2>/dev/null || cd /; }

# ttyd is not exec'd: this script stays PID 1's child so a Supervisor stop
# reaches it (see on_stop) and can wind Claude down before the container is
# torn down. It still exits with ttyd's status, so ttyd dying ends the
# container exactly as before. The subshell resets INT/QUIT, which bash
# ignores in background jobs; ttyd's ptys would otherwise inherit that.
start_ttyd() {
  cd_work
  # shellcheck disable=SC2086  # SHELL_CMD is intentionally word-split
  ( trap - INT QUIT; exec ttyd --port 7681 --writable --ping-interval 30 --max-clients 5 \
    --index /usr/share/ttyd/index.html \
    -t "fontSize=${FONT_SIZE:-14}" \
    -t fontFamily=Monaco,Consolas,monospace \
    -t scrollback=20000 \
    -t macOptionClickForcesSelection=true \
    -t "theme=${COLORS:-background=#1e1e2e,foreground=#cdd6f4,cursor=#f5e0dc}" \
    ${SHELL_CMD:-bash --login} ) &
  TTYD_PID=$!
  wait "$TTYD_PID"
  local rc=$?
  shutdown_jobs   # ttyd died on its own: don't orphan the endpoint or in-flight runs
  exit $rc
}
on_abort() {
  echo "[ERROR] Startup aborted (exit $1); starting a bare terminal so you can debug from inside the add-on"
  trap - EXIT
  start_ttyd
}

# Stop: with init:true only this process gets the Supervisor's SIGTERM. A
# Claude running under tmux (pre-started at boot or opened from the terminal)
# or directly under ttyd would otherwise be SIGKILLed when the container is
# torn down - mid tool call, with its Remote Control session left dangling.
#
# Every terminal - a tmux pane or a ttyd pty - is rooted at claude-auto-launch
# (or a shell); claude and anything it spawned are that root's descendants.
# Signal the descendants, never the root: killing the root closes the pty and
# SIGHUPs claude the instant after its SIGTERM. The wrapper sees claude exit
# 143 and drops to a login shell, which tmux kill-server / ttyd's own teardown
# clean up.
descendants() {  # $1 = pid -> all descendant pids, depth first
  local kid
  for kid in $(pgrep -P "$1" 2>/dev/null); do
    echo "$kid"
    descendants "$kid"
  done
}
stop_sessions() {
  local root pids="" pid alive i
  for root in $(tmux list-panes -a -F '#{pane_pid}' 2>/dev/null) \
              $([ -n "$TTYD_PID" ] && pgrep -P "$TTYD_PID" 2>/dev/null); do
    pids="$pids $(descendants "$root")"
  done
  for pid in $pids; do kill -TERM "$pid" 2>/dev/null; done
  # A browser (re)connecting now would spawn a fresh Claude that we then kill:
  # stop ttyd first when tmux holds the sessions (its ttyd children are only
  # tmux clients). Without tmux the pty IS the session, so ttyd waits.
  local tmux_mode=""
  if tmux has-session 2>/dev/null; then tmux_mode=1; stop_ttyd; fi
  for ((i = 0; i < STOP_GRACE_SECS * 2; i++)); do
    alive=""
    for pid in $pids; do kill -0 "$pid" 2>/dev/null && alive=1; done
    [ -n "$alive" ] || break
    sleep 0.5
  done
  [ -n "$alive" ] && warn "Claude did not exit within ${STOP_GRACE_SECS}s; stopping anyway"
  [ -n "$tmux_mode" ] && tmux kill-server 2>/dev/null
  return 0
}
stop_ttyd() {
  [ -n "$TTYD_PID" ] || return 0
  kill -TERM "$TTYD_PID" 2>/dev/null
  local i
  for ((i = 0; i < 10; i++)); do
    kill -0 "$TTYD_PID" 2>/dev/null || break
    sleep 0.5
  done
  kill -KILL "$TTYD_PID" 2>/dev/null
  wait "$TTYD_PID" 2>/dev/null
  TTYD_PID=""
}
# Claude Jobs stop path (Appendix A.1). Every run is tracked by exactly one file,
# $RUN_DIR/jobs/<name>.pgid = {"pgid": <runner group>, "child_pgid": <timeout+
# claude group>, ...}; the endpoint keeps no child table and nothing here walks
# process trees. All three functions are no-ops when nothing is running.
job_groups() {  # $1 = jq filter over each pgid file (default: runner AND claude groups)
  local f
  for f in "$RUN_DIR"/jobs/*.pgid; do
    [ -e "$f" ] || continue
    jq -r "${1:-(.pgid // empty), (.child_pgid // empty)}" "$f" 2>/dev/null
  done
}
stop_job_spawners() {  # <= 2 s: nothing new can spawn after this
  touch "$RUN_DIR/stopping" 2>/dev/null
  local ep i
  ep=$(cat "$RUN_DIR/endpoint.pid" 2>/dev/null)
  [ -n "$JOB_LOOP_PID" ] && kill -TERM "$JOB_LOOP_PID" 2>/dev/null
  [ -n "$ep" ] || return 0
  kill -TERM "$ep" 2>/dev/null
  for ((i = 0; i < 4; i++)); do
    kill -0 "$ep" 2>/dev/null || return 0
    sleep 0.5
  done
  kill -KILL "$ep" 2>/dev/null
  return 0
}
signal_job_runs() {  # instant: TERM lands early so runners publish `aborted` while sessions wind down
  # Only the RUNNER's group gets TERM: the runner relays it to claude and owns
  # the `aborted` record. Signalling claude's group directly would make the
  # runner see an external kill instead (integration review #1).
  local pg n=0
  for pg in $(job_groups '.pgid // empty'); do
    case "$pg" in (''|*[!0-9]*) continue ;; esac
    kill -TERM -- "-$pg" 2>/dev/null && n=$((n + 1))
  done
  [ "$n" -gt 0 ] && info "Signalled $n job process group(s) to stop"
  return 0
}
reap_job_runs() {  # <= JOB_STOP_GRACE_SECS, then KILL whatever is left
  local pg alive i f
  for ((i = 0; i < JOB_STOP_GRACE_SECS * 2; i++)); do
    alive=""
    for pg in $(job_groups); do
      case "$pg" in (''|*[!0-9]*) continue ;; esac
      kill -0 -- "-$pg" 2>/dev/null && alive=1
    done
    [ -n "$alive" ] || break
    sleep 0.5
  done
  for pg in $(job_groups); do
    case "$pg" in (''|*[!0-9]*) continue ;; esac
    kill -KILL -- "-$pg" 2>/dev/null
  done
  [ -n "$alive" ] && warn "Job runs did not exit within ${JOB_STOP_GRACE_SECS}s; killed"
  for f in "$RUN_DIR"/jobs/*.pgid; do [ -e "$f" ] && rm -f "$f"; done
  return 0
}
shutdown_jobs() { stop_job_spawners; signal_job_runs; reap_job_runs; }
on_stop() {
  trap - EXIT TERM INT HUP
  stop_job_spawners   # nothing new can spawn
  signal_job_runs     # TERM lands early ...
  stop_sessions       # ... so runners drain while the interactive session tears down
  reap_job_runs
  stop_ttyd
  exit 143
}
# A Supervisor stop/restart must end the container, not start a terminal:
# bash runs the EXIT trap on an untrapped SIGTERM, so on_stop clears it first.
# (A SIGTERM that lands while a startup step is in the foreground is acted on
# when that step returns; the steps are individually bounded by `timeout`.)
trap on_stop TERM INT HUP
trap 'on_abort $?' EXIT

info() { echo "[INFO] $*"; }
warn() { echo "[WARN] $*"; }
err()  { echo "[ERROR] $*"; }
opt()  { jq -r "$1" "$OPTS" 2>/dev/null; }

# ---------------------------------------------------------------------------
# settings.json: one guarded, atomic writer.
# ---------------------------------------------------------------------------
settings_init() {
  if [ ! -d "$(dirname "$SETTINGS_FILE")" ]; then
    warn "$(dirname "$SETTINGS_FILE") does not exist; settings.json will not be applied this boot"
    return 0
  fi
  if [ ! -e "$SETTINGS_FILE" ]; then
    echo '{}' > "$SETTINGS_FILE" || warn "Could not create settings.json"
    return 0
  fi
  # Must be an object, and .permissions (which every write below indexes into)
  # must be an object or absent.
  if jq -e 'type == "object" and ((.permissions // {}) | type == "object")' "$SETTINGS_FILE" > /dev/null 2>&1; then
    return 0
  fi
  local quarantine
  quarantine="$SETTINGS_FILE.corrupt.$(date +%s)"
  if mv "$SETTINGS_FILE" "$quarantine" 2>/dev/null; then
    warn "settings.json is not usable; the old file was saved as $quarantine"
    echo '{}' > "$SETTINGS_FILE" || warn "Could not create a fresh settings.json"
  else
    # Never overwrite the only copy: leave it and let each write warn.
    warn "settings.json is not usable and could not be moved aside; leaving it in place"
  fi
}

# settings_set [jq options...] '<filter>'
# The temp file sits beside the target so the final mv is a same-filesystem
# rename: an interrupted write can never leave a truncated settings.json.
settings_set() {
  local tmp="$SETTINGS_FILE.tmp"
  if jq "$@" "$SETTINGS_FILE" > "$tmp" && mv "$tmp" "$SETTINGS_FILE"; then
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# ---------------------------------------------------------------------------
# Steps
# ---------------------------------------------------------------------------
export HA_TOKEN="$SUPERVISOR_TOKEN"
export HA_URL="http://supervisor/core"

setup_persist_dir() {
  if ! mkdir -p "$PERSIST_DIR/config" "$PERSIST_DIR/gh" /root/.config; then
    warn "Could not create $PERSIST_DIR - is the Home Assistant config volume mounted and writable?"
    warn "Skipping persistent config setup; nothing will persist across restarts"
    return 0
  fi
  cp /usr/share/claudecode/CLAUDE.addon.md "$PERSIST_DIR/CLAUDE.md" \
    || warn "Could not refresh CLAUDE.md in the config dir"
  if [ ! -f "$PERSIST_DIR/CLAUDE.user.md" ]; then
    printf '%s\n' \
      '# User Instructions' \
      '' \
      'Edit this file to add your own persistent instructions for Claude Code.' \
      '' \
      'The add-on creates this file once and never overwrites it, so anything' \
      'here survives restarts and add-on updates. It is imported into every' \
      'Claude Code session via `~/.claude/CLAUDE.md`.' \
      > "$PERSIST_DIR/CLAUDE.user.md" || warn "Could not create CLAUDE.user.md"
  fi

  # Everything Claude Code and gh keep under $HOME lives on the HA volume.
  if [ ! -L /root/.claude ]; then
    rm -rf /root/.claude
    ln -s "$PERSIST_DIR" /root/.claude || warn "Could not link /root/.claude"
  fi
  if [ ! -L /root/.config/claude-code ]; then
    rm -rf /root/.config/claude-code
    ln -s "$PERSIST_DIR/config" /root/.config/claude-code || warn "Could not link /root/.config/claude-code"
  fi
  if [ ! -L /root/.claude.json ]; then
    touch "$PERSIST_DIR/.claude.json" || warn "Could not create .claude.json"
    rm -f /root/.claude.json
    ln -s "$PERSIST_DIR/.claude.json" /root/.claude.json || warn "Could not link /root/.claude.json"
  fi
  if [ ! -L /root/.config/gh ]; then
    rm -rf /root/.config/gh
    ln -s "$PERSIST_DIR/gh" /root/.config/gh || warn "Could not link /root/.config/gh"
  fi
}

read_options() {
  FONT_SIZE=$(opt '.terminal_font_size // 14')
  THEME=$(opt '.terminal_theme // "dark"')
  SESSION_PERSIST=$(opt 'if .session_persistence == null then true else .session_persistence end')
  ENABLE_MCP=$(opt 'if .enable_mcp == null then true else .enable_mcp end')
  ENABLE_PLAYWRIGHT=$(opt '.enable_playwright_mcp // false')
  PLAYWRIGHT_HOST=$(opt '.playwright_cdp_host // ""')
  AUTO_UPDATE=$(opt '.auto_update_claude // false')
  DEFAULT_MODE=$(opt '.default_permission_mode // "auto"')
  ENABLE_RC=$(opt '.enable_remote_control // false')
  RC_PREFIX=$(opt '.remote_control_session_prefix // "HomeAssistant"')
  AUTO_LAUNCH=$(opt '.auto_launch_claude // "continue"')
  EXTRA_PKGS=$(opt '.extra_npm_packages // [] | join(" ")')
  JOB_DEFAULT_MODEL=$(opt '.job_default_model // "fable"')
  ENABLE_JOBS=$(opt '.enable_job_endpoint // false')
  # Sane fallbacks if options.json itself was unreadable.
  : "${FONT_SIZE:=14}" "${THEME:=dark}" "${SESSION_PERSIST:=true}" "${ENABLE_MCP:=true}"
  : "${ENABLE_PLAYWRIGHT:=false}" "${AUTO_UPDATE:=false}" "${DEFAULT_MODE:=auto}"
  : "${ENABLE_RC:=false}" "${RC_PREFIX:=HomeAssistant}" "${AUTO_LAUNCH:=continue}"
  : "${JOB_DEFAULT_MODEL:=fable}" "${ENABLE_JOBS:=false}"
}

scrub_legacy_token() {
  # Versions before 1.2.65-con.1 persisted $SUPERVISOR_TOKEN into settings.json.
  jq -e '.mcpServers.homeassistant.env.HASS_TOKEN' "$SETTINGS_FILE" > /dev/null 2>&1 || return 0
  if settings_set 'del(.mcpServers.homeassistant.env.HASS_TOKEN)'; then
    info "Removed a Supervisor token that older versions persisted into settings.json"
    info "That file lives in your HA config dir and is included in backups"
  else
    warn "Could not strip the persisted Supervisor token from settings.json - it is still there"
  fi
}

check_avx() {
  grep -qw avx /proc/cpuinfo 2>/dev/null && return 0
  warn "This CPU does not expose AVX. Claude Code 2.1.113+ is a Bun-compiled"
  warn "binary that requires it, so this add-on is running an older release."
  warn 'On Proxmox set the VM CPU type to "host" (or x86-64-v3), then fully'
  warn "stop and start the VM. Verify with: grep -o -m1 avx2 /proc/cpuinfo"
}

claude_responds() { timeout 30 claude --version < /dev/null > /dev/null 2>&1; }

maybe_update_claude() {
  BUILT_VERSION=$(cat /etc/claude-code-version 2>/dev/null || echo unknown)
  if [ "$AUTO_UPDATE" != "true" ]; then
    info "Claude Code $BUILT_VERSION (verified at build time)"
    return 0
  fi
  warn "auto_update_claude=true; the build verified $BUILT_VERSION, an update may install a release that cannot run (and writes to the container layer)"
  timeout 300 npm update -g @anthropic-ai/claude-code || warn "Update failed; keeping the installed version"
  if claude_responds; then
    CLAUDE_OK=true  # check_claude will not probe again
  else
    err "The updated Claude Code does not run here; rolling back to $BUILT_VERSION"
    timeout 300 npm install -g "@anthropic-ai/claude-code@$BUILT_VERSION" || err "Rollback failed"
  fi
}

install_extra_npm_packages() {
  [ -n "$EXTRA_PKGS" ] || return 0
  local prefix=$PERSIST_DIR/npm-global log=/tmp/npm-extra.log rc
  if ! mkdir -p "$prefix"; then
    warn "Could not create $prefix; skipping extra_npm_packages"
    return 0
  fi
  info "Installing extra_npm_packages: $EXTRA_PKGS"
  # shellcheck disable=SC2086  # EXTRA_PKGS is a space-separated list
  timeout -k 10 180 npm install -g --prefix="$prefix" $EXTRA_PKGS > "$log" 2>&1
  rc=$?
  tail -5 "$log" 2>/dev/null
  case $rc in
    0)   ;;
    124) warn "extra_npm_packages install timed out after 180s (registry unreachable or slow); continuing without them" ;;
    *)   warn "extra_npm_packages install failed (npm exit $rc); continuing without them" ;;
  esac
}

check_claude() {
  if [ "$CLAUDE_OK" = "true" ] || claude_responds; then
    CLAUDE_OK=true
  else
    CLAUDE_OK=false
    err "claude CLI did not respond within 30s - skipping MCP setup and auto-launch"
    err "The terminal will still start so you can debug from inside the add-on"
  fi
}

configure_mcp() {
  if [ "$CLAUDE_OK" = "true" ]; then
    timeout 30 claude mcp remove homeassistant -s user > /dev/null 2>&1 || true
    timeout 30 claude mcp remove playwright -s user > /dev/null 2>&1 || true
  fi

  if [ "$CLAUDE_OK" = "true" ] && [ "$ENABLE_MCP" = "true" ]; then
    if timeout 30 claude mcp add-json homeassistant '{"command":"hass-mcp"}' -s user; then
      info "MCP configured with Home Assistant integration"
      local allowed='["mcp__homeassistant__get_version","mcp__homeassistant__get_entity","mcp__homeassistant__list_entities","mcp__homeassistant__search_entities_tool","mcp__homeassistant__domain_summary_tool","mcp__homeassistant__list_automations","mcp__homeassistant__get_history","mcp__homeassistant__get_error_log","Read(/homeassistant/**)","Read(/config/**)","Read(/share/**)","Read(/media/**)","Glob(/homeassistant/**)","Glob(/config/**)","Grep(/homeassistant/**)","Grep(/config/**)"]'
      if settings_set --argjson tools "$allowed" '.permissions.allow = ($tools + (.permissions.allow // []) | unique)'; then
        info "Pre-authorized read-only MCP tools"
      else
        warn "Could not pre-authorize MCP tools in settings.json"
      fi
    else
      warn "claude mcp add-json failed; Home Assistant MCP not configured"
    fi
  elif [ "$ENABLE_MCP" = "true" ]; then
    warn "MCP is enabled but was skipped: the claude CLI is not responding"
  else
    info "MCP disabled"
  fi

  if [ "$CLAUDE_OK" = "true" ] && [ "$ENABLE_PLAYWRIGHT" = "true" ]; then
    local pw_json
    pw_json=$(jq -nc --arg host "$PLAYWRIGHT_HOST" '{command:"/usr/local/bin/playwright-mcp-launch", env:{PLAYWRIGHT_CDP_HOST:$host}}')
    if timeout 30 claude mcp add-json playwright "$pw_json" -s user; then
      if [ -n "$PLAYWRIGHT_HOST" ]; then
        info "Playwright MCP enabled (host override: $PLAYWRIGHT_HOST)"
      else
        info "Playwright MCP enabled (hostname auto-detected each time the MCP server starts)"
      fi
    else
      warn "claude mcp add-json failed; Playwright MCP not configured"
    fi
  elif [ "$ENABLE_PLAYWRIGHT" = "true" ]; then
    warn "Playwright MCP is enabled but was skipped: the claude CLI is not responding"
  else
    info "Playwright MCP disabled"
  fi
}

apply_settings() {
  if settings_set --arg mode "$DEFAULT_MODE" '.permissions.defaultMode = $mode'; then
    info "Default permission mode: $DEFAULT_MODE"
  else
    warn "Could not set permissions.defaultMode=$DEFAULT_MODE in settings.json"
  fi
  if [ "$ENABLE_RC" = "true" ]; then
    settings_set '.remoteControlAtStartup = true' || warn "Could not enable remoteControlAtStartup in settings.json"
    export CLAUDE_REMOTE_CONTROL_SESSION_NAME_PREFIX="$RC_PREFIX"
  else
    settings_set 'del(.remoteControlAtStartup)' || warn "Could not clear remoteControlAtStartup in settings.json"
  fi
}

# ---------------------------------------------------------------------------
# Claude Jobs (docs/DESIGN-claude-jobs.md). The runner (`claude-job`) works from
# the terminal on every install; the HTTP endpoint and the generated HA package
# are opt-in (enable_job_endpoint). Same discipline as every step above: warn
# and move on.
# ---------------------------------------------------------------------------
setup_job_dirs() {
  local fresh=""
  [ -d "$JOBS_DIR" ] || fresh=1
  if mkdir -p "$JOBS_DIR/logs" "$JOBS_DIR/state/inbox" "$JOBS_DIR/state/disabled" "$JOBS_DIR/state/actions"; then
    # Seed the two shipped example jobs once, when the directory is first
    # created - never again, so a job the user deleted stays deleted. Pristine
    # copies remain in /usr/share/claudecode/jobs/.
    if [ -n "$fresh" ]; then
      cp /usr/share/claudecode/jobs/*.md "$JOBS_DIR/" 2>/dev/null \
        && info "Seeded example jobs into $JOBS_DIR (health-check, energy-report)"
    fi
    [ -e /usr/share/claudecode/notify.example.yaml ] \
      && cp /usr/share/claudecode/notify.example.yaml "$JOBS_DIR/_notify.example.yaml" 2>/dev/null
  else
    warn "Could not create $JOBS_DIR; scheduled jobs will not work this boot"
  fi
  # The job cwd is deliberately empty and on /data: no mapped-volume ancestor
  # can inject a CLAUDE.md, and nothing here rides in the HA backup (§4.1).
  if ! { mkdir -p "$JOB_DATA_DIR/project" && chmod 700 "$JOB_DATA_DIR"; }; then
    warn "Could not create $JOB_DATA_DIR"
  fi
  # /run is wiped with the container; a leftover `stopping` flag or pgid file
  # can only be from a previous life of this container (restart without
  # recreate), so clear them.
  if mkdir -p "$RUN_DIR/jobs" "$RUN_DIR/run" && chmod 700 "$RUN_DIR"; then
    rm -f "$RUN_DIR/stopping" "$RUN_DIR/endpoint.pid" "$RUN_DIR/endpoint.status" "$RUN_DIR"/jobs/*.pgid "$RUN_DIR"/run/* 2>/dev/null
  else
    warn "Could not create $RUN_DIR (AppArmor?); job runs cannot be tracked or stopped cleanly"
  fi
  info "Default job model: $JOB_DEFAULT_MODEL"
}

# The job runner isolates every run with CLI flags that auto_update_claude could
# in principle take away. The runner and endpoint refuse to run when one is
# missing (cli_preflight, §4.9); this only makes the reason visible at boot.
cli_preflight_log() {
  [ "$CLAUDE_OK" = "true" ] || return 0
  local help missing="" f
  help=$(timeout 30 claude --help < /dev/null 2>/dev/null) || { warn "claude --help failed; skipping job CLI preflight"; return 0; }
  for f in --setting-sources --settings --tools --json-schema --strict-mcp-config; do
    printf '%s' "$help" | grep -q -- "$f" || missing="$missing $f"
  done
  if [ -n "$missing" ]; then
    warn "claude --help does not list:$missing - scheduled jobs will refuse to run until the CLI has them (see cli_preflight in the docs)"
  else
    info "Job CLI preflight: all isolation flags present"
  fi
}

# The interactive Claude may list, validate, dry-run, run and disable jobs
# without a prompt; enable, force-run and token deliberately still ask (§7):
# disabling is fail-safe, enabling undoes a human decision.
allow_job_commands() {
  local rules='["Bash(claude-job list)","Bash(claude-job list:*)","Bash(claude-job validate:*)","Bash(claude-job dry-run:*)","Bash(claude-job run:*)","Bash(claude-job disable:*)"]'
  if settings_set --argjson r "$rules" '.permissions.allow = ((.permissions.allow // []) + $r | unique)'; then
    info "Pre-authorized read-only claude-job commands for the interactive session"
  else
    warn "Could not add claude-job allow rules to settings.json"
  fi
}

# The endpoint's bearer token: 64 hex chars in /data (not in the HA backup set,
# not readable through any job path grant). Generated once; `claude-job token
# rotate` replaces it and the endpoint picks it up on the next request (§4.9).
ensure_job_token() {
  [ "$ENABLE_JOBS" = "true" ] || return 0
  if timeout 30 claude-job token ensure > /dev/null; then
    info "Job endpoint token present in $JOB_DATA_DIR/token (show it with: claude-job token show)"
  else
    warn "Could not create the job endpoint token; HA will not be able to trigger jobs"
  fi
}

# The Home Assistant side - rest_command, the anchor sensor, the alarm and the
# schedule blueprint - is one generated package with this add-on's hostname and
# the endpoint token filled in (§4.10, §6.4). Rendered on every start so token
# rotation and hostname changes heal themselves; on a git-backed config dir the
# renderer keeps the file out of git and warns if it is already tracked.
render_job_package() {
  [ "$ENABLE_JOBS" = "true" ] || return 0
  timeout 60 python3 "$JOB_LIB/render_package.py"
  case $? in
    0) info "Wrote /homeassistant/claudecode_jobs.yaml (include it once from configuration.yaml: homeassistant: packages: claudecode_jobs: !include claudecode_jobs.yaml)" ;;
    1) warn "claudecode_jobs.yaml written, but the schedule blueprint or the .git exclude entry could not be; see the lines above" ;;
    2) warn "claudecode_jobs.yaml was NOT written; see the lines above" ;;
    *) warn "Rendering claudecode_jobs.yaml failed or timed out" ;;
  esac
  return 0
}

# The trigger endpoint runs under a never-give-up respawn loop (Appendix A.5):
# backoff 1 -> 60 s doubling; five fast crashes in a row degrade to 300 s retries
# and raise sensor.claude_jobs_endpoint = error so the failure is visible in HA
# even though nothing HA-side is polling yet. The loop ends when on_stop
# touches $RUN_DIR/stopping.
publish_endpoint_error() {  # $1 = reason, $2 = fast crash count
  local body
  body=$(jq -nc --arg r "$1" --arg n "$2" \
    --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{state: "error", attributes: {reason: $r, fast_crashes: ($n | tonumber), since: $t, friendly_name: "Claude Jobs endpoint", icon: "mdi:server-off"}}') || return 0
  curl -fsS --max-time 5 -o /dev/null -X POST \
    -H "Authorization: Bearer $SUPERVISOR_TOKEN" -H 'Content-Type: application/json' \
    -d "$body" http://supervisor/core/api/states/sensor.claude_jobs_endpoint 2>/dev/null || true
}
start_job_endpoint() {
  if [ "$ENABLE_JOBS" != "true" ]; then
    info "Job endpoint disabled (enable_job_endpoint: false); jobs can still be run from the terminal"
    return 0
  fi
  (
    trap - INT QUIT
    exec < /dev/null
    backoff=1 fast=0
    while [ ! -e "$RUN_DIR/stopping" ]; do
      started=$SECONDS
      "$JOB_ENDPOINT_BIN" &
      ep=$!
      echo "$ep" > "$RUN_DIR/endpoint.pid"
      printf '{"status":"running","pid":%s,"fast_crashes":%s}\n' "$ep" "$fast" > "$RUN_DIR/endpoint.status"
      wait "$ep"
      rc=$?
      [ -e "$RUN_DIR/stopping" ] && break
      if [ $((SECONDS - started)) -lt 10 ]; then fast=$((fast + 1)); else fast=0; backoff=1; fi
      if [ "$fast" -ge 5 ]; then
        backoff=300
        publish_endpoint_error respawn_degraded "$fast"
      fi
      echo "[WARN] claude-job-endpoint exited ($rc); respawning in ${backoff}s"
      printf '{"status":"respawning","rc":%s,"backoff_s":%s,"fast_crashes":%s}\n' "$rc" "$backoff" "$fast" > "$RUN_DIR/endpoint.status"
      sleep "$backoff" &
      wait $!
      [ "$backoff" -lt 60 ] && backoff=$((backoff * 2))
    done
    exit 0
  ) &
  JOB_LOOP_PID=$!
  info "Job endpoint started on port $JOB_ENDPOINT_PORT (supervised; pid $JOB_LOOP_PID)"
}

build_shell_cmd() {
  if [ "$THEME" = "dark" ]; then
    COLORS='background=#1e1e2e,foreground=#cdd6f4,cursor=#f5e0dc'
  else
    COLORS='background=#eff1f5,foreground=#4c4f69,cursor=#dc8a78'
  fi

  [ "$CLAUDE_OK" = "true" ] || AUTO_LAUNCH=off
  CLAUDE_FLAGS=""
  [ "$ENABLE_RC" = "true" ] && CLAUDE_FLAGS="--remote-control"
  case "$AUTO_LAUNCH" in
    continue) AUTO_LAUNCH_ARGS="--continue $CLAUDE_FLAGS" ;;
    new)      AUTO_LAUNCH_ARGS="$CLAUDE_FLAGS" ;;
    *)        AUTO_LAUNCH_ARGS="" ;;
  esac
  export CLAUDE_FLAGS AUTO_LAUNCH_ARGS
  info "Auto-launch: $AUTO_LAUNCH; remote-control: $ENABLE_RC"

  # What each terminal runs; under tmux it is the pane command.
  local pane_cmd
  if [ "$AUTO_LAUNCH" != "off" ]; then
    pane_cmd=/usr/local/bin/claude-auto-launch
  else
    pane_cmd=""
  fi
  if [ "$SESSION_PERSIST" = "true" ]; then
    # ttyd attaches (-A) to the `claude` session; prestart_session creates it
    # detached (-d) with the same pane command.
    SHELL_CMD="tmux new-session -A -s claude${pane_cmd:+ $pane_cmd}"
    PRESTART_CMD="tmux new-session -d -s claude${pane_cmd:+ $pane_cmd}"
  else
    SHELL_CMD="${pane_cmd:-bash --login}"
    PRESTART_CMD=""
  fi
}

