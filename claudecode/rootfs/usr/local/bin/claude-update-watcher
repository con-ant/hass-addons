#!/bin/bash
# claude-update-watcher: move idle Claude sessions onto an installed update.
#
# Claude Code updates itself in the background: it installs the new release
# over /usr/local/lib/node_modules/@anthropic-ai/claude-code, but every
# running session keeps executing the old binary until it is restarted. On an
# unattended box (Remote Control, a session pre-started at boot) nobody ever
# restarts it, so the session runs an old release indefinitely.
#
# Every POLL_SECS this looks at each tmux pane whose root is
# claude-auto-launch. When the pane's claude is running another release than
# the installed one, and the session is idle, it marks the pane and sends
# claude SIGTERM; claude-auto-launch sees the mark and relaunches the new
# release on the same conversation (claude-session-hook recorded its id).
#
# Another release, not another file: installing the release that is already
# there replaces the binary all the same, and a session on it has nothing to
# gain from a restart. That happens every 30 minutes while any Claude is on a
# release older than the channel's: Claude Code's updater compares the channel
# with the release its own process runs, not with the one installed, and runs
# `npm install -g` again each time (read in the 2.1.330 CLI; npm replacing the
# binary of an unchanged release checked with 2.1.323). Comparing files, as
# this did up to con.38, restarted every idle session after each of those.
#
# Idle means both:
#   - no turn in flight: the Stop hook stamped the last finished turn at or
#     after the last prompt. An interrupted turn fires no Stop hook, so a turn
#     that has shown no sign of life for STALE_TURN_SECS counts as over
#     anyway. A turn parked on an unanswered permission prompt looks the
#     same, so the question is dropped after that hour and asked again on
#     resume. A sign of life is a prompt, a key typed by an attached client,
#     or output in LIVE_POLLS polls running, as a working Claude's spinner
#     gives. Output now and then is not one: the updater above prints
#     "Auto-updating" in the very session that is behind, every 30 minutes
#     (seen live: the pane's window_activity moved 8 s after each install),
#     which keeps an interrupted turn looking alive for good, and the session
#     behind, reinstalling. Five polls, so that a slow install's start and
#     end, minutes apart, do not add up to one;
#   - the pane has been quiet for IDLE_SECS: nothing printed (tmux
#     window_activity; Claude's spinner prints while it works) and nothing
#     typed by an attached client (session_activity).
#
# A release is only moved onto once `claude --version` answers from it, so a
# release that cannot run on this host (the AVX story in install-claude.sh)
# never takes a working session down. Started by claudecode-start when
# apply_claude_updates is on; stopped by its on_stop.
POLL_SECS=${CLAUDE_UPDATE_POLL_SECS:-60}
IDLE_SECS=${CLAUDE_UPDATE_IDLE_SECS:-900}
STALE_TURN_SECS=${CLAUDE_UPDATE_STALE_TURN_SECS:-3600}
LIVE_POLLS=${CLAUDE_UPDATE_LIVE_POLLS:-5}
PANES=${CLAUDE_PANE_STATE_DIR:-/run/claudecode/panes}
PROCS=${CLAUDE_PROC_STATE_DIR:-/run/claudecode/procs}
RC_PIDFILE=${CLAUDE_RC_SERVER_PIDFILE:-/run/claudecode/rc-server.pid}
# Holds the server's pid, written just before it is signalled: claudecode-start's
# loop compares it with the pid it waited on to tell this restart from a crash,
# since `claude remote-control` exits 0 (not 143) on SIGTERM.
RC_MARK=${CLAUDE_RC_RESTART_MARK:-/run/claudecode/rc-restart}
# The release claudecode-start reinstalls at boot; recorded here as soon as a
# release has answered --version, so a crash or power cut (no on_stop) keeps it.
CLI_VERSION_FILE=${CLAUDE_CLI_VERSION_FILE:-/data/claudecode/cli-version}
CLI_BAD_FILE=${CLAUDE_CLI_BAD_FILE:-/data/claudecode/cli-bad}          # releases a boot could not bring back
CLI_VERIFIED_FILE=${CLAUDE_CLI_VERIFIED_FILE:-/run/claudecode/cli-verified}  # read by claudecode-start's on_stop
BOOT=$(awk '/^btime/ {print $2}' /proc/stat)
HZ=$(getconf CLK_TCK 2>/dev/null || echo 100)

info() { echo "[$(date +%H:%M:%S)] [INFO] $*"; }
warn() { echo "[$(date +%H:%M:%S)] [WARN] $*"; }

BAD_RETRY_SECS=${CLAUDE_UPDATE_BAD_RETRY_SECS:-600}
verified=""   # "<key>:ok" or "<key>:bad:<epoch>" for the installed binary last checked
warned=""     # the key a "does not run here" warning was last logged for
signaled=" "  # pids already sent SIGTERM: a Claude winding down is not signalled again
ok_key=""     # the key of the installed binary that last answered --version
reinstalled="" # set when the release already installed was installed again
reported=""   # the Claude processes on another release last named in the log
declare -A release_of asked_at    # binary key -> the release it answered --version with ("" = it did not), and when it was asked
managed=" "   # this round's Claudes in panes that claude-auto-launch supervises
declare -A seen_out streak live   # per pane: last output seen, polls running with new output, last sign of life

is_release() { [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
# What `claude --version` printed -> the version: the first word of the first
# line that starts with one, pre-releases included. Empty when there is none
# (a warning ahead of the version is skipped; output without one names nothing).
version_in() { printf '%s\n' "$1" | awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.+-]*)?$/ { print $1; exit }'; }
remember_release() {  # $1 = version that answered --version
  local have
  is_release "$1" || return 0
  mkdir -p "${CLI_VERIFIED_FILE%/*}" 2>/dev/null && printf '%s\n' "$1" > "$CLI_VERIFIED_FILE" 2>/dev/null
  # Only forward: a newer release remembered but not brought back this boot
  # (cache miss, timed out probe) must not be replaced by the older one running.
  have=$(cat "$CLI_VERSION_FILE" 2>/dev/null)
  [ "$have" = "$1" ] && return 0
  if is_release "$have" && ! grep -qxF "$have" "$CLI_BAD_FILE" 2>/dev/null; then
    [ "$(printf '%s\n%s\n' "$1" "$have" | sort -V | tail -n 1)" = "$1" ] || return 0
  fi
  mkdir -p "${CLI_VERSION_FILE%/*}" 2>/dev/null \
    && printf '%s\n' "$1" > "$CLI_VERSION_FILE.tmp" 2>/dev/null \
    && mv -f "$CLI_VERSION_FILE.tmp" "$CLI_VERSION_FILE" 2>/dev/null
  return 0
}

# Sets BIN to the installed binary once it is known to run. Fails while an
# update is mid-install or when the new release does not run here. Not called
# in a subshell: the verdict is cached in $verified.
#
# The cache key is inode, size and mtime, so a binary npm was still writing
# when it was first checked is checked again as soon as it is complete. A
# failure is retried after BAD_RETRY_SECS, so a transient one (the 30 s
# timeout under load) does not strand sessions until the next release; one
# that keeps failing, like a release without AVX support, is logged once.
installed_ok() {
  local bin key out now v
  bin=$(readlink -f "$(command -v claude)" 2>/dev/null) || return 1
  [ -x "$bin" ] || return 1
  key=$(stat -c '%i-%s-%Y' "$bin" 2>/dev/null) || return 1
  now=$(date +%s)
  case $verified in
    "$key:ok") BIN=$bin; return 0 ;;
    "$key:bad:"*) [ $((now - ${verified##*:})) -lt "$BAD_RETRY_SECS" ] && return 1 ;;
  esac
  if out=$(timeout 30 "$bin" --version < /dev/null 2>&1); then
    verified="$key:ok"
    BIN=$bin
    # No version in the answer: INSTALLED_VERSION stays empty, which matches
    # no session's release, so only the file itself counts as "on it".
    v=$(version_in "$out")
    release_of[$key]=$v
    if [ -n "$v" ] && [ -n "$ok_key" ] && [ "$key" != "$ok_key" ] && [ "$v" = "$INSTALLED_VERSION" ]; then
      reinstalled=1
      info "Claude Code $INSTALLED_VERSION was installed again: the same release, so sessions already on it keep running"
    else
      INSTALLED_VERSION=$v
      info "Claude Code ${INSTALLED_VERSION:-(version not recognised: ${out%%$'\n'*})} is installed; idle sessions on another release will be restarted onto it"
    fi
    ok_key=$key
    remember_release "$INSTALLED_VERSION"
  else
    verified="$key:bad:$now"
    if [ "$warned" != "$key" ]; then
      warned=$key
      warn "The installed Claude Code does not run here ($(printf '%s' "$out" | tail -1)); sessions stay on the release they run, and it is checked again every ${BAD_RETRY_SECS}s"
    fi
    return 1
  fi
}

# Is that Claude on the installed release? The same file is; so is another
# file that answered --version with the same release, which is what a session
# runs after the release it is on was installed again. A binary this watcher
# never checked (replaced within a poll of being installed) is asked through
# /proc/<pid>/exe, which still reaches it once npm has deleted it (checked on
# the add-on under its AppArmor profile). One that cannot be asked counts as
# another release, as every other file did before; it is asked again after
# BAD_RETRY_SECS, so one timeout under load is not held against it for good.
# Leaves the release in PROC_RELEASE ("" = unknown). Not called in a
# subshell: the answers are cached in release_of.
on_installed() {  # $1 = pid
  local key out now
  PROC_RELEASE=$INSTALLED_VERSION
  [ "/proc/$1/exe" -ef "$BIN" ] && return 0
  PROC_RELEASE=""
  key=$(stat -L -c '%i-%s-%Y' "/proc/$1/exe" 2>/dev/null) || return 1
  now=$(date +%s)
  if [ -z "${release_of[$key]}" ] && [ $((now - ${asked_at[$key]:-0})) -ge "$BAD_RETRY_SECS" ]; then
    out=$(version_in "$(timeout 30 "/proc/$1/exe" --version < /dev/null 2>/dev/null)")
    [ -e "/proc/$1/exe" ] || return 1   # it exited meanwhile: that is no answer about its binary
    release_of[$key]=$out
    asked_at[$key]=$now
  fi
  PROC_RELEASE=${release_of[$key]}
  [ -n "$PROC_RELEASE" ] && [ "$PROC_RELEASE" = "$INSTALLED_VERSION" ]
}

# The pane's claude: the child of the claude-auto-launch root whose executable
# is (or was, before the update deleted it) the npm-installed Claude Code.
pane_claude() {  # $1 = pane root pid
  local kid exe
  for kid in $(pgrep -P "$1" 2>/dev/null); do
    exe=$(readlink "/proc/$kid/exe" 2>/dev/null) || continue
    case $exe in */@anthropic-ai/*) echo "$kid"; return 0 ;; esac
  done
  return 1
}

# The Remote Control server (remote_control_server) is restarted onto an
# update only when every session it has spawned is idle: no turn in flight,
# and no prompt, finished turn or (re)start for IDLE_SECS. Its sessions
# survive the restart - the server keeps its environment and reattaches them
# - but a turn in flight would be cut off. claude-session-hook stamps those
# sessions per Claude process, since they have no tmux pane.
descendants() {  # $1 = pid -> every descendant pid
  local kid
  for kid in $(pgrep -P "$1" 2>/dev/null); do echo "$kid"; descendants "$kid"; done
}
server_idle() {  # $1 = server pid
  local kid lp ls started last now
  now=$(date +%s)
  # All descendants, not just children: a release that spawns sessions
  # through an intermediate process must not look like a server with none.
  for kid in $(descendants "$1"); do
    case $(readlink "/proc/$kid/exe" 2>/dev/null) in */@anthropic-ai/*) ;; *) continue ;; esac
    lp=$(cat "$PROCS/$kid/last-prompt" 2>/dev/null); lp=${lp:-0}
    ls=$(cat "$PROCS/$kid/last-stop" 2>/dev/null); ls=${ls:-0}
    started=$(( BOOT + $(awk '{sub(/.*\) /, ""); print $20}' "/proc/$kid/stat" 2>/dev/null || echo 0) / HZ ))  # starttime; comm may hold spaces
    last=$lp; [ "$ls" -gt "$last" ] && last=$ls; [ "$started" -gt "$last" ] && last=$started
    if [ "$lp" -gt "$ls" ] && [ $((now - lp)) -lt "$STALE_TURN_SECS" ]; then return 1; fi
    [ $((now - last)) -ge "$IDLE_SECS" ] || return 1
  done
  return 0
}

# After the release already installed was installed again: name the Claude
# processes that are on another one, since one of them asked for it and will
# again in 30 minutes. The sessions this watcher supervises leave that list as
# they go idle; a Claude started by hand stays until somebody restarts it
# (seen on a real box: `claude --remote-control` typed into the terminal's
# shell after the launcher's own Claude had exited, twelve days on 2.1.311,
# reinstalling 2.1.323 every 30 minutes). A
# headless run (-p) has no updater and is listed only so the list is whole.
# Logged when the list changes, not every 30 minutes.
old_claudes() {
  local exe pid kind started list="" rc_pids=""
  [ -n "$rpid" ] && rc_pids="$rpid $(descendants "$rpid" | tr '\n' ' ')"
  for exe in /proc/[0-9]*/exe; do
    case $(readlink "$exe" 2>/dev/null) in */@anthropic-ai/*) ;; *) continue ;; esac
    pid=${exe#/proc/}; pid=${pid%/exe}
    on_installed "$pid" && continue
    [ -e "$exe" ] || continue
    kind="started by hand: nothing restarts it, exit it and start it again"
    case " $(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)" in
      *" -p "*|*" --print "*) kind="a headless run, which ends by itself" ;;
    esac
    case $managed in *" $pid "*) kind="terminal session, restarted once idle" ;; esac
    case " $rc_pids " in
      *" $pid "*) kind="Remote Control, restarted once its sessions are idle" ;;
    esac
    started=$(( BOOT + $(awk '{sub(/.*\) /, ""); print $20}' "/proc/$pid/stat" 2>/dev/null || echo 0) / HZ ))
    list="$list pid $pid on ${PROC_RELEASE:-an unknown release} since $(date -d "@$started" '+%d %b %H:%M' 2>/dev/null || echo "$started") ($kind);"
  done
  [ "$list" = "$reported" ] && return 0
  reported=$list
  [ -n "$list" ] || return 0
  warn "Claude Code $INSTALLED_VERSION was installed again because a Claude on another release asked for it, and will every 30 minutes until it restarts:${list%;}"
}

while sleep "$POLL_SECS"; do
  now=$(date +%s)
  # Every pane's signs of life, on every poll (also while an update is being
  # installed): a restart decision needs the history, not this round's glance.
  mapfile -t panes < <(tmux list-panes -a -F '#{pane_id} #{pane_pid} #{window_activity} #{session_activity}' 2>/dev/null)
  for line in "${panes[@]}"; do
    read -r pane root win_act sess_act <<< "$line"
    [ -n "${live[$pane]}" ] || live[$pane]=$now   # first seen: a full STALE_TURN_SECS before a turn counts as over
    if [ "${win_act:-0}" -gt "${seen_out[$pane]:-0}" ]; then
      streak[$pane]=$(( ${streak[$pane]:-0} + 1 ))
    else
      streak[$pane]=0
    fi
    seen_out[$pane]=${win_act:-0}
    [ "${streak[$pane]}" -ge "$LIVE_POLLS" ] && live[$pane]=$now
    [ "${sess_act:-0}" -gt "${live[$pane]}" ] && live[$pane]=$sess_act
  done
  installed_ok || continue
  managed=" "
  for line in "${panes[@]}"; do
    read -r pane root win_act sess_act <<< "$line"
    case $(tr '\0' ' ' < "/proc/$root/cmdline" 2>/dev/null) in
      *claude-auto-launch*) ;;
      *) continue ;;   # a shell or a claude started by hand: nobody would relaunch it
    esac
    pid=$(pane_claude "$root") || continue
    managed="$managed$pid "
    case $signaled in *" $pid "*) continue ;; esac
    on_installed "$pid" && continue
    quiet=$(( now - (win_act > sess_act ? win_act : sess_act) ))
    [ "$quiet" -ge "$IDLE_SECS" ] || continue
    state=$PANES/${pane#%}
    last_prompt=$(cat "$state/last-prompt" 2>/dev/null); last_prompt=${last_prompt:-0}
    last_stop=$(cat "$state/last-stop" 2>/dev/null); last_stop=${last_stop:-0}
    alive=${live[$pane]}; [ "$last_prompt" -gt "$alive" ] && alive=$last_prompt
    if [ "$last_prompt" -gt "$last_stop" ] && [ $((now - alive)) -lt "$STALE_TURN_SECS" ]; then
      continue   # a turn is in flight
    fi
    # The installed release may have changed since the top of this round:
    # check it again (cached unless the file changed) so a session is only
    # ever moved onto a release that has answered --version.
    installed_ok || break
    on_installed "$pid" && continue
    mkdir -p "$state" 2>/dev/null && touch "$state/restart-for-update" 2>/dev/null || {
      warn "Cannot mark pane $pane for restart; leaving it on the older release"
      continue
    }
    info "Restarting the Claude session in pane $pane (pid $pid, idle ${quiet}s) onto Claude Code ${INSTALLED_VERSION:-update}; it resumes the same conversation"
    if kill -TERM "$pid" 2>/dev/null; then
      signaled="$signaled$pid "
    else
      rm -f "$state/restart-for-update"   # it exited by itself meanwhile
    fi
  done

  rpid=$(cat "$RC_PIDFILE" 2>/dev/null)
  if [ -n "$reinstalled" ]; then
    reinstalled=""
    old_claudes
  fi
  case $signaled in *" $rpid "*) rpid="" ;; esac
  if [ -n "$rpid" ] && [ -e "/proc/$rpid/exe" ] && ! on_installed "$rpid" \
     && server_idle "$rpid" && installed_ok && ! on_installed "$rpid"; then
    info "Restarting the Remote Control server (pid $rpid) onto Claude Code ${INSTALLED_VERSION:-update}; its sessions are idle and reattach"
    echo "$rpid" 2>/dev/null > "$RC_MARK" \
      || warn "Cannot mark the Remote Control server's restart; its loop will take it for a crash and wait 30s"
    if kill -TERM "$rpid" 2>/dev/null; then
      signaled="$signaled$rpid "
    else
      rm -f "$RC_MARK"   # it exited by itself meanwhile
    fi
  fi
  # Forget pids that have exited, so a later Claude the kernel hands the same
  # pid is not mistaken for one already signalled and left on an old release.
  for p in $signaled; do [ -e "/proc/$p" ] || signaled=${signaled/ $p / }; done
  # State of Claude processes that have exited.
  for d in "$PROCS"/*/; do
    [ -d "$d" ] || continue
    d=${d%/}; [ -e "/proc/${d##*/}" ] || rm -rf "$d"
  done
done
