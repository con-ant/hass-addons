[Unit]
Description=EAST EA900 G4 Modbus to NUT bridge
Documentation=https://networkupstools.org/docs/man/dummy-ups.html
After=network.target
Before=nut-driver.target

[Service]
Type=simple
EnvironmentFile=-/etc/east2nut.conf
# No .pyc next to the script: the host boots from an SD card and this would be
# rewritten on every start. It also keeps the root filesystem clean enough to
# be mounted read-only (or overlayed) later.
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/local/sbin/east2nut.py
Restart=always
RestartSec=5

# The state file is rewritten every 10s. The host boots from an SD card, so it
# lives on tmpfs: systemd creates /run/east2nut and Preserve keeps it across a
# daemon restart so the dummy-ups driver never loses its file.
RuntimeDirectory=east2nut
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Persistent, unlike the state file: /var/lib/east2nut holds discharges.csv,
# which is appended only while the UPS is on battery. A real outage takes Home
# Assistant down with it, so this host is the only one that can record the event.
StateDirectory=east2nut
StateDirectoryMode=0755

# Hardening: it needs the serial port and nothing else writable.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
DeviceAllow=/dev/ttyUSB0 rw

[Install]
WantedBy=multi-user.target
